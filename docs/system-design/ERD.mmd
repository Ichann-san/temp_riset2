    account {
        uuid id PK
        text status
    }
    patient {
        uuid id PK
        bytea nik_ciphertext
        text nik_lookup_digest UK
    }
    visit {
        uuid id PK
        uuid patient_id FK
        date service_date
        text booking_code UK
        integer queue_number
        text status
    }
    examination {
        uuid id PK
        uuid visit_id FK
        uuid service_version_id FK
        text status
        integer version
    }
    result_revision {
        uuid id PK
        uuid examination_id FK
        integer revision
        jsonb payload
    }
    outbox_job {
        uuid id PK
        text dedupe_key UK
        text status
        timestamptz lease_until
    }
    audit_event {
        bigint id PK
        uuid actor_id FK
        text action
        uuid entity_id
    }
    idempotency_record {
        uuid actor_id PK
        text action PK
        text request_key PK
        text request_digest
    }
