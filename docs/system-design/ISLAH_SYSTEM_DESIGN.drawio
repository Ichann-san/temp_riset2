        <mxCell id="c-db" value="PostgreSQL" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=8;fillColor=#EAF6EE;strokeColor=#16801C;fontColor=#14592C;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="590" y="980" width="95" height="46" as="geometry" />
        </mxCell>
        <mxCell id="current-note" value="Next.js rewrites /api/v1/* to 127.0.0.1:5000; no browser-to-DB connection.&lt;br&gt;Operator CLI opens H+1. Review tokens exist; production account / staff security does not." style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=11;fontStyle=0;fontColor=#526158;" vertex="1" parent="1">
          <mxGeometry x="70" y="1042" width="610" height="38" as="geometry" />
        </mxCell>
        <mxCell id="deployment-note" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#34443B;&quot;&gt;&lt;b&gt;DESIGN NOTE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Deployment and access principles&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Docker containers are proposed; Compose suits development / pilot deployment.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Scale HTTP processes / replicas within database and resource budgets; no fixed SLA promised.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Target: separate public / private entrypoints, service credentials and route allowlists.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Enforce account ownership, staff roles and unit scope on every authorized server operation.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;PostgreSQL is the single authoritative database; MongoDB / Cassandra are not required.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FAFCFB;strokeColor=#CCD8D1;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="50" y="1350" width="850" height="180" as="geometry" />
        </mxCell>
        <mxCell id="pending-note" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#485667;&quot;&gt;&lt;b&gt;UNDECIDED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Production decisions remain open&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Hosting, reverse proxy / load balancer, replica counts and monitoring / backup products.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Production account verification, staff SSO / MFA, detailed permissions and result delegation.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Payment provider, charges, reconciliation, hold expiration and late-payment handling.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Integration contracts, official result templates, retention and operational recovery objectives.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Clinical queue inputs / constraints need hospital validation before automatic scheduling.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#F3F4F6;strokeColor=#8D98A6;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="940" y="1350" width="850" height="180" as="geometry" />
        </mxCell>
