        <mxCell id="patient" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#34443B;&quot;&gt;&lt;b&gt;ACTOR&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Patient / representative&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Uses a responsible account.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Patient may be someone else.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Submits one patient per booking.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Production account login: planned.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A9B7AF;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="50" y="235" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hospital-team" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#34443B;&quot;&gt;&lt;b&gt;ACTOR&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Clinical operations&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;MCU staff: arrival / worklists&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Unit staff: exams / result input&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Unit doctors: result verification&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;MCU doctors: final review&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Workspaces exist in the UI.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Clinical backend: planned.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A9B7AF;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="250" height="260" as="geometry" />
        </mxCell>
        <mxCell id="oversight" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#34443B;&quot;&gt;&lt;b&gt;ACTOR&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Management / editor&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Management: reports / feedback&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Editor: calendar / service catalog&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Uses staff workspace.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Production permissions: unresolved.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A9B7AF;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="50" y="850" width="250" height="185" as="geometry" />
        </mxCell>
        <mxCell id="registration" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#14592C;&quot;&gt;&lt;b&gt;LIVE REGISTRATION BACKEND&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;1  Registration&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;H+1 date assigned by the server.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Validate patient and account limits.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Reserve main place or join FIFO.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Return a registration reference.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#EAF6EE;strokeColor=#16801C;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="390" y="235" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;2  Payment &amp;amp; confirmation&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Hold remains while payment is due.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Apply only verified payment.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Convert held place to confirmed.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Issue official MCU queue number.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="740" y="235" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="arrival" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;3  Arrival &amp;amp; re-registration&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;MCU staff checks booking / identity.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Record arrival and visit readiness.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Prepare required examinations.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Registration FIFO is not this queue.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="1090" y="235" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="routing" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;4  Clinical queue routing&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Choose an eligible next unit.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Use capacity, duration and travel.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Respect clinical prerequisites.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Show room / location guidance.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Algorithm and data need validation.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="390" y="520" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="examination" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;5  Unit examination&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Record staff / doctor presence.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Record patient IN and OUT times.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Perform the required examination.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Physical completion differs from&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;result verification.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="740" y="520" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="unit-results" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;6  Unit results &amp;amp; verification&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Unit staff submits result revision.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Unit doctor checks / verifies it.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Record approved charges / honor.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Financial rules still need approval.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="1090" y="520" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="final-review" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;7  Final MCU review&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Wait for all required unit results.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;MCU doctor verifies the record.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Handle corrections with history.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Approve final result document.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="390" y="820" width="300" height="175" as="geometry" />
        </mxCell>
        <mxCell id="delivery" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;8  Results &amp;amp; certificates&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Authorized results / visit history.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Request eligible certificates.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Generate / deliver private documents.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Notify without exposing medical data.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Submit service feedback.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="740" y="820" width="300" height="175" as="geometry" />
        </mxCell>
        <mxCell id="management" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Reports &amp;amp; configuration&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Aggregated wait / TAT metrics.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Feedback and capacity reporting.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Manage calendar and service catalog.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Role and unit permissions: pending.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="1090" y="820" width="300" height="175" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#485667;&quot;&gt;&lt;b&gt;PLANNED / PROVIDER UNDECIDED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Payment gateway&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Online payment provider: TBD.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Verified events confirm a held place.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;No amount or timeout invented.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;No payment integration built yet.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#F3F4F6;strokeColor=#8D98A6;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="1480" y="235" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="collective-intake" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED / BATCH RULES UNRESOLVED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Collective intake&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;MCU doctor uploads a CSV batch.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Validate rows and review the preview.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Pass accepted participants to booking.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Batch allocation, account and payment&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;rules require hospital decisions.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="1480" y="520" width="310" height="180" as="geometry" />
        </mxCell>
        <mxCell id="notification" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#725211;&quot;&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Patient notification&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;WhatsApp provider: planned.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Notify patient when document is ready.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Use an authenticated result link.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Delivery failure needs retry / review.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#FFF8E8;strokeColor=#BE9947;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="1480" y="820" width="310" height="175" as="geometry" />
        </mxCell>
        <mxCell id="record-note" value="One controlled record model spans the service; PostgreSQL is the authoritative database.&lt;br&gt;Only the registration backend is connected today. Most clinical screens use local browser state." style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontStyle=0;fontColor=#526158;" vertex="1" parent="1">
          <mxGeometry x="390" y="1042" width="1000" height="44" as="geometry" />
        </mxCell>
        <mxCell id="gateway-label" value="Payment request / verified event" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontSize=12;fontStyle=0;fontColor=#725211;" vertex="1" parent="1">
          <mxGeometry x="1080" y="187" width="340" height="22" as="geometry" />
        </mxCell>
        <mxCell id="arrival-label" value="After staff validates the arriving patient" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontSize=12;fontStyle=0;fontColor=#725211;" vertex="1" parent="1">
          <mxGeometry x="740" y="443" width="410" height="22" as="geometry" />
        </mxCell>
        <mxCell id="routing-loop-label" value="More examinations: re-evaluate the next eligible unit" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontSize=12;fontStyle=0;fontColor=#725211;" vertex="1" parent="1">
          <mxGeometry x="560" y="716" width="310" height="22" as="geometry" />
        </mxCell>
        <mxCell id="final-label" value="All required unit results verified" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontSize=12;fontStyle=0;fontColor=#725211;" vertex="1" parent="1">
          <mxGeometry x="770" y="758" width="450" height="22" as="geometry" />
        </mxCell>
        <mxCell id="metrics-label" value="Aggregate metrics" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;text;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontSize=11;fontStyle=0;fontColor=#725211;" vertex="1" parent="1">
          <mxGeometry x="1120" y="724" width="190" height="21" as="geometry" />
        </mxCell>
        <mxCell id="capacity-rules" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#14592C;&quot;&gt;&lt;b&gt;IMPLEMENTED REGISTRATION RULES&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Registration invariants&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;100 main places = held + confirmed. 50 FIFO waiting places are not extra confirmed exams.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Only H+1, using Asia/Jakarta. Operator opens the service date; patients cannot choose a date.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Final submission holds a place. Owner cancellation releases it and promotes FIFO.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;One unfinished application per account; one active registration per account / service date.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Duplicate NIK per service date is rejected. No automatic hold-expiry timer is implemented.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#EAF6EE;strokeColor=#16801C;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="50" y="1160" width="850" height="190" as="geometry" />
        </mxCell>
        <mxCell id="open-rules" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#485667;&quot;&gt;&lt;b&gt;UNDECIDED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#172C22;&quot;&gt;&lt;b&gt;Hospital decisions still needed&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Payment provider, fees, refund / reconciliation rules, and hold expiry or abandonment policy.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Production account verification, staff access by role / unit, and medical-result delegation.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Clinical scheduling constraints, unit durations / travel times, official services and tariffs.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;SIMRS / identity interfaces, notification contracts, opening hours and operational exceptions.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;Payment confirmation and official queue-number issuance remain planned; no latency SLA set.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;overflow=hidden;rounded=1;arcSize=5;fillColor=#F3F4F6;strokeColor=#8D98A6;strokeWidth=1.2;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#34443B;" vertex="1" parent="1">
          <mxGeometry x="940" y="1160" width="850" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
