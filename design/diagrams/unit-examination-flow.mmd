flowchart TB
    %% Alur satu kunjungan di unit pemeriksaan. Layout vertikal untuk app.diagram.net.
    %% Verifikasi hasil dan pencatatan biaya berlangsung setelah pelayanan pasien.

    START([Pasien dijadwalkan ke unit pemeriksaan])
    D1{"Dokter pemeriksa sudah<br/>check-in di ruangan?"}
    O1["DOKTER PEMERIKSA<br/>Check-in dan nyatakan unit siap"]
    S1["SISTEM<br/>Panggil pasien dari antrean unit"]
    P1["PASIEN<br/>Masuk ruangan"]
    O2["DOKTER PEMERIKSA<br/>Cocokkan identitas dan<br/>jenis pemeriksaan"]
    D2{"Identitas dan permintaan<br/>pemeriksaan sesuai?"}
    X1["PETUGAS MCU<br/>Periksa ketidaksesuaian sebelum<br/>pemeriksaan dilanjutkan"]
    STOP([Pemeriksaan ditunda])

    S2["SISTEM<br/>Catat waktu mulai pemeriksaan"]
    O3["DOKTER PEMERIKSA<br/>Lakukan pemeriksaan"]
    O4["DOKTER PEMERIKSA<br/>Simpan temuan dan lampiran<br/>sebagai draf"]
    O5["DOKTER PEMERIKSA<br/>Akhiri pemeriksaan pasien"]
    P2["PASIEN<br/>Keluar ruangan"]
    S3["SISTEM<br/>Catat waktu selesai pelayanan<br/>dan perbarui status pemeriksaan"]

    O6["DOKTER PEMERIKSA<br/>Lengkapi hasil dan tentukan<br/>honorarium sendiri"]
    D3{"Hasil pemeriksaan<br/>lengkap?"}
    O7["DOKTER PEMERIKSA<br/>Perbaiki atau lengkapi draf"]
    O8["DOKTER PEMERIKSA<br/>Submit hasil untuk verifikasi"]
    S4["SISTEM<br/>Simpan versi hasil dan catat<br/>waktu serta identitas pengirim"]

    S5["SISTEM<br/>Kirim hasil ke alur verifikasi medis"]
    S6["SISTEM<br/>Kirim komponen honorarium<br/>dan biaya lain ke proses keuangan"]
    O9["DOKTER PEMERIKSA<br/>Siap menerima pasien berikutnya"]
    END([Kunjungan unit selesai])

    START --> D1
    D1 -- Belum --> O1 --> S1
    D1 -- Sudah --> S1
    S1 --> P1 --> O2 --> D2
    D2 -- Tidak --> X1 --> STOP
    D2 -- Ya --> S2 --> O3 --> O4 --> O5 --> P2 --> S3 --> O6 --> D3
    D3 -- Tidak --> O7 --> D3
    D3 -- Ya --> O8 --> S4
    S4 --> S5
    S4 --> S6
    S4 --> O9 --> END

    classDef terminal fill:#172033,color:#FFFFFF,stroke:#172033,stroke-width:2px;
    classDef doctor fill:#EAF7EE,color:#173B23,stroke:#3B8A57,stroke-width:1.5px;
    classDef patient fill:#EEF8F1,color:#173B23,stroke:#4F8A62,stroke-width:1.5px;
    classDef system fill:#E8F1FB,color:#172033,stroke:#4976A8,stroke-width:1.5px;
    classDef decision fill:#FFF5DB,color:#172033,stroke:#C58B16,stroke-width:2px;
    classDef exception fill:#FDECEC,color:#5E1C1C,stroke:#C75454,stroke-width:1.5px;

    class START,STOP,END terminal;
    class O1,O2,O3,O4,O5,O6,O7,O8,O9 doctor;
    class P1,P2 patient;
    class S1,S2,S3,S4,S5,S6 system;
    class D1,D2,D3 decision;
    class X1 exception;
